rules_version='2';
service cloud.firestore{match /databases/{db}/documents{
 function ok(){return request.auth!=null}
 match /users/{u}{allow read:if ok();allow create,update,delete:if ok()&&request.auth.uid==u;}
 match /posts/{p}{allow read:if ok();
  allow create:if ok()&&request.resource.data.uid==request.auth.uid&&request.resource.data.text.size()<=1000;
  allow delete:if ok()&&resource.data.uid==request.auth.uid;
  allow update:if ok()&&(resource.data.uid==request.auth.uid||request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','cc']));
  match /comments/{c}{allow read:if ok();allow create:if ok()&&request.resource.data.uid==request.auth.uid&&request.resource.data.text.size()<=500;allow delete:if ok()&&resource.data.uid==request.auth.uid;}}
 match /chats/{cid}/msgs/{m}{allow read:if ok()&&request.auth.uid in cid.split('_');allow create:if ok()&&request.auth.uid in cid.split('_')&&request.resource.data.from==request.auth.uid;}
}}
